<ConfigScreen>
    MDBoxLayout:
        orientation: "vertical"

        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "4dp", 0
            md_bg_color: app.theme_cls.primary_color

            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_main()

            MDLabel:
                text: "Configuration"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1

            Widget:
                size_hint_x: None
                width: "80dp"

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "15dp"
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "SYSTEM CONFIGURATION"
                    halign: "center"
                    bold: True
                    font_size: "20sp"
                    size_hint_y: None
                    height: "40dp"

                MDTextField:
                    id: txt_server_ip
                    hint_text: "Server IP"
                    mode: "rectangle"
                    size_hint_x: 1

                # บรรทัดเดียวกัน: Device Name : [ค่า]
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "30dp"
                    spacing: "10dp"

                    MDLabel:
                        text: "Device Name :"
                        bold: True
                        size_hint_x: None
                        width: "120dp"

                    MDLabel:
                        id: lbl_device_name
                        text: "-"

                # บรรทัดเดียวกัน: Status : [ค่า]
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "30dp"
                    spacing: "10dp"

                    MDLabel:
                        text: "Status :"
                        bold: True
                        size_hint_x: None
                        width: "120dp"

                    MDLabel:
                        id: lbl_status
                        text: "Not Connected"

                Widget:
                    size_hint_y: None
                    height: "10dp"

                MDRaisedButton:
                    text: "CONNECT"
                    size_hint: 1, None
                    height: "50dp"
                    pos_hint: {"center_x": .5}
                    on_release: root.connect_server()

                Widget:
                    size_hint_y: None
                    height: "20dp"