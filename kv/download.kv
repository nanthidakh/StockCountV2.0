<DownloadScreen>:

    MDBoxLayout:
        orientation: "vertical"

        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "4dp", 0
            md_bg_color: app.theme_cls.primary_color

            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_main()

            MDLabel:
                text: "Download Plan"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1

            Widget:
                size_hint_x: None
                width: "80dp"

        MDBoxLayout:
            orientation: "vertical"
            padding: "12dp"
            spacing: "8dp"

            MDLabel:
                text: "DOWNLOAD PLAN"
                halign: "center"
                bold: True
                font_size: "16sp"
                size_hint_y: None
                height: "26dp"

            MDTextField:
                id: txt_plan
                hint_text: "Plan ID"
                mode: "rectangle"
                helper_text: "กรอกเลข Plan"
                helper_text_mode: "on_focus"
                input_filter: "int"
                multiline: False
                size_hint_y: None
                height: "48dp"
                font_size: "14sp"
                on_text_validate: root.start_download()

            MDRaisedButton:
                id: btn_download
                text: "DOWNLOAD"
                size_hint_x: 1
                size_hint_y: None
                height: "44dp"
                font_size: "14sp"
                disabled: root.is_downloading
                on_release: root.start_download()

            MDProgressBar:
                id: progress
                value: root.progress_value
                min: 0
                max: 100
                size_hint_y: None
                height: "8dp"

            MDLabel:
                id: lbl_status
                text: root.status_text
                halign: "center"
                font_size: "13sp"
                size_hint_y: None
                height: "34dp"

            MDSeparator:

            MDGridLayout:
                cols: 2
                adaptive_height: True
                spacing: "8dp"
                padding: "5dp"

                MDLabel:
                    text: "Plan ID"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_plan_id
                    text: str(root.downloaded_plan_id)
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Plan Code"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_plan_code
                    text: root.downloaded_plan_code
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Location"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_location
                    text: "{:,}".format(root.location_count)
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Item"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_item
                    text: "{:,}".format(root.item_count)
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Barcode"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_barcode
                    text: "{:,}".format(root.barcode_count)
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Detail"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    id: lbl_detail_count
                    text: "{:,}".format(root.detail_count)
                    halign: "right"
                    font_size: "13sp"
                    size_hint_y: None
                    height: "26dp"

            Widget: