#:import OneLineListItem kivymd.uix.list.OneLineListItem

<CountStockHeader@MDBoxLayout>:
    size_hint_y: None
    height: "56dp"
    padding: "4dp", 0
    md_bg_color: app.theme_cls.primary_color

<CountStockMenuScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "12dp"
        spacing: "8dp"

        MDBoxLayout:
            size_hint_y: None
            height: "48dp"

            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                size_hint_x: None
                width: "80dp"
                on_release: root.go_launcher()

            MDLabel:
                text: "CountStock"
                font_name: "ThaiFont"
                bold: True
                halign: "center"

            Widget:
                size_hint_x: None
                width: "80dp"

        MDLabel:
            text: "เตรียมข้อมูลนับสต๊อก"
            font_name: "ThaiFont"
            bold: True
            halign: "center"
            size_hint_y: None
            height: "42dp"

        MDLabel:
            text: "เลือกเมนูที่ต้องการใช้งาน"
            font_name: "ThaiFont"
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "30dp"

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height

                MDRaisedButton:
                    text: "ตั้งค่า"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("countstock_config")

                MDRaisedButton:
                    text: "นำเข้าข้อมูลสินค้า"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("countstock_import")

                MDRaisedButton:
                    text: "เก็บข้อมูลรายการสินค้า"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("countstock_scan")

                MDRaisedButton:
                    text: "Export Data"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("countstock_export")

                MDRaisedButton:
                    text: "ออกจากโปรแกรม"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    md_bg_color: 0.35, 0.35, 0.35, 1
                    on_release: root.exit_app()

        MDLabel:
            text: "Version " + str(app.version)
            font_name: "ThaiFont"
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "28dp"

<CountStockConfigScreen>:
    MDBoxLayout:
        orientation: "vertical"
        CountStockHeader:
            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()
            MDLabel:
                text: "ตั้งค่าข้อมูล"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
            Widget:
                size_hint_x: None
                width: "80dp"
        MDBoxLayout:
            orientation: "vertical"
            padding: "20dp"
            spacing: "14dp"
            MDTextField:
                id: txt_iis_ip
                hint_text: "IIS Server IP"
                mode: "rectangle"
            MDRaisedButton:
                text: "โหลด config.ashx"
                font_name: "ThaiFont"
                size_hint: 1, None
                height: "50dp"
                on_release: root.fetch_config()
            MDRaisedButton:
                id: btn_branch
                text: "เลือกสาขา"
                font_name: "ThaiFont"
                size_hint: 1, None
                height: "50dp"
            MDLabel:
                id: lbl_detail
                text: "DB: -\nเดือน: -"
                font_name: "ThaiFont"
                halign: "center"
            MDRaisedButton:
                text: "บันทึก"
                font_name: "ThaiFont"
                size_hint: 1, None
                height: "50dp"
                on_release: root.save()
            Widget:

<CountStockImportScreen>:
    MDBoxLayout:
        orientation: "vertical"
        CountStockHeader:
            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()
            MDLabel:
                text: "นำเข้าข้อมูลสินค้า"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
            Widget:
                size_hint_x: None
                width: "80dp"
        MDBoxLayout:
            orientation: "vertical"
            padding: "20dp"
            spacing: "16dp"
            MDLabel:
                id: lbl_sqlite_count
                text: "ข้อมูลในเครื่อง\nสินค้า 0 รายการ\nบาร์โค้ด 0 รายการ"
                font_name: "ThaiFont"
                font_size: "13sp"
                halign: "center"
                size_hint_y: None
                height: "70dp"
            MDLabel:
                id: lbl_status
                text: "พร้อมนำเข้าข้อมูลสินค้า"
                font_name: "ThaiFont"
                font_size: "13sp"
                halign: "center"
            MDRaisedButton:
                id: btn_import
                text: "นำเข้า"
                size_hint: 1, None
                height: "55dp"
                on_release: root.start_import()
            Widget:

<CountStockScanScreen>:
    MDBoxLayout:
        orientation: "vertical"

        CountStockHeader:
            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()

            MDLabel:
                text: "เก็บข้อมูลรายการสินค้า"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1

            Widget:
                size_hint_x: None
                width: "80dp"

        MDBoxLayout:
            orientation: "vertical"
            padding: "10dp"
            spacing: "6dp"

            MDBoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "8dp"

                MDLabel:
                    text: "Staff :"
                    font_name: "ThaiFont"
                    size_hint_x: None
                    width: "72dp"
                    halign: "right"
                    valign: "middle"
                    text_size: self.size

                MDRaisedButton:
                    id: btn_staff
                    text: "-เลือก-"
                    font_name: "ThaiFont"
                    size_hint_x: None
                    width: "145dp"
                    md_bg_color: 1.0, 0.55, 0.0, 1
                    on_release: root.open_staff_menu()

                Widget:

            MDBoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "5dp"

                ScannerTextField:
                    id: txt_location
                    hint_text: "Location"
                    font_name: "ThaiFont"
                    mode: "rectangle"
                    multiline: False
                    write_tab: False
                    readonly: root.location_locked
                    on_touch_down: root.prepare_location_field(self, args[1])
                    on_text_validate: root.on_location_validate()

                MDRaisedButton:
                    id: btn_lock_location
                    text: "ล็อก LOC"
                    font_name: "ThaiFont"
                    size_hint_x: None
                    width: "105dp"
                    md_bg_color: (0.16, 0.58, 0.28, 1) if root.location_locked else app.theme_cls.primary_color
                    on_release: root.toggle_location_lock()

            ScannerTextField:
                id: txt_barcode
                hint_text: "Barcode / Item Code"
                font_name: "ThaiFont"
                mode: "rectangle"
                multiline: False
                write_tab: False
                size_hint_y: None
                height: "48dp"
                on_touch_down: root.prepare_field(self, args[1], True)
                on_text_validate: root.scan()

            MDLabel:
                id: lbl_result
                text: "พร้อมสแกน"
                font_name: "ThaiFont"
                font_size: "13sp"
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: "56dp"

            MDLabel:
                text: "รายการล่าสุด — แก้ LOC/ลบได้เฉพาะรายการที่ยังไม่ Sync"
                font_name: "ThaiFont"
                bold: True
                font_size: "13sp"
                size_hint_y: None
                height: "28dp"

            ScrollView:
                do_scroll_x: False

                MDBoxLayout:
                    id: recent_list
                    orientation: "vertical"
                    font_size: "13sp"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "2dp"

<CountStockExportScreen>:
    MDBoxLayout:
        orientation: "vertical"

        CountStockHeader:
            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()
            MDLabel:
                text: "Export CountStock"
                font_name: "ThaiFont"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
            Widget:
                size_hint_x: None
                width: "80dp"

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "12dp"

            MDLabel:
                id: lbl_export_count
                text: "ข้อมูลทั้งหมด 0 รายการ\nSync แล้ว 0 \nยังไม่ Sync 0"
                font_name: "ThaiFont"
                font_size: "14sp"
                halign: "center"
                size_hint_y: None
                height: "78dp"

            MDLabel:
                text: "Export ข้อมูลชุดปัจจุบัน \n เลือกExport ได้อย่างใดอย่างหนึ่งเท่านั้น\n"
                font_name: "ThaiFont"
                font_size: "14sp"
                bold: True
                halign: "center"
                size_hint_y: None
                height: "30dp"
            MDRaisedButton:
                id: btn_export_scan_data
                text: "เก็บข้อมูลพร้อมขอ Slottag"
                font_name: "ThaiFont"
                font_size: "14sp"
                size_hint: 1, None
                height: "52dp"
                on_release: root.export_to("Countstock_scan_data")

            MDRaisedButton:
                id: btn_export_slottag
                text: "ขอ Slottag อย่างเดียว"
                font_name: "ThaiFont"
                font_size: "14sp"
                size_hint: 1, None
                height: "52dp"
                on_release: root.export_to("Countstock_scan_slottag")

            MDLabel:
                id: lbl_status
                text: "พร้อมส่งข้อมูล"
                font_name: "ThaiFont"
                font_size: "14sp"
                halign: "center"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: "54dp"
          
            MDRaisedButton:
                text: "ลบข้อมูลในเครื่อง"
                font_name: "ThaiFont"
                font_size: "14sp"
                size_hint: 1, None
                height: "50dp"
                md_bg_color: .8, .2, .2, 1
                on_release: root.clear_data()

            Widget:

