<MainMenuScreen>:
    name: "main_menu"

    MDBoxLayout:
        orientation: "vertical"
        padding: "12dp"
        spacing: "8dp"

        MDBoxLayout:
            size_hint_y: None
            height: "48dp"

            MDFlatButton:
                text: "กลับ"
                font_name: "ThaiFont"
                size_hint_x: None
                width: "80dp"
                on_release: root.go_launcher()

            MDLabel:
                text: "Hardware King Stock Count"
                font_name: "ThaiFont"
                bold: True
                halign: "center"

            Widget:
                size_hint_x: None
                width: "80dp"

        MDLabel:
            id: lbl_device
            text: "ชื่อเครื่อง : "
            font_name: "ThaiFont"
            halign: "center"
            size_hint_y: None
            height: "30dp"
            shorten: True

        MDLabel:
            id: lbl_status
            text: "เลือกเมนูที่ต้องการใช้งาน"
            font_name: "ThaiFont"
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "30dp"

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height

                MDRaisedButton:
                    text: "1. ตั้งค่า"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("config_screen", "config")

                MDRaisedButton:
                    text: "2. นำเข้าข้อมูลแผนนับสต๊อก"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("download_screen", "download")

                MDRaisedButton:
                    text: "3. นับสินค้า"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("count_screen", "count")

                MDRaisedButton:
                    text: "4. Audit"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.go_to("audit_screen", "audit")

                MDRaisedButton:
                    text: "5. ออกจากโปรแกรม"
                    font_name: "ThaiFont"
                    size_hint_x: 1
                    size_hint_y: None
                    height: "48dp"
                    md_bg_color: 0.35, 0.35, 0.35, 1
                    on_release: root.confirm_exit_app()
